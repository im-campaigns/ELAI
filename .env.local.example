ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Supabase (회원가입/로그인/1:1교육 대화 히스토리/커리큘럼 진도 저장용)
# https://supabase.com 에서 무료 프로젝트를 만든 뒤,
# Project Settings > API 에서 아래 두 값을 복사해 붙여넣으세요.
# 그 다음 supabase/schema.sql 내용을 Supabase SQL Editor에서 한 번 실행해주세요.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# 로그인 세션 쿠키 서명용 비밀키 (임의의 긴 무작위 문자열 설정)
SESSION_SECRET=your_random_session_secret_here

# 관리자 페이지(/admin) 비밀번호 (아이디는 admin 고정, 비밀번호 기본값은 0909)
ADMIN_PASSWORD=0909

# 비밀번호 찾기 시 임시 비밀번호 이메일 발송용 (https://resend.com 에서 발급)
RESEND_API_KEY=your_resend_api_key_here
# 발신자 주소. 도메인을 인증하기 전에는 Resend가 제공하는 onboarding@resend.dev 만 사용 가능.
# elai-zeta.vercel.app 도메인을 Resend에서 인증한 뒤 "ELAI <noreply@elai-zeta.vercel.app>" 로 바꾸세요.
RESEND_FROM_EMAIL=ELAI <onboarding@resend.dev>
